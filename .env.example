# General
ENV=paper
LOG_LEVEL=INFO

# RollSlope execution
ROLLSLOPE_BROKER=paper
ROLLSLOPE_SYMBOL=2330
ROLLSLOPE_EQUITY=1000000
ROLLSLOPE_PEAK_EQUITY=1000000
ROLLSLOPE_MAX_LOTS=1

# Shioaji / SinoPac Securities
# Never commit real credentials.
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_SIMULATION=true
SHIOAJI_DEFAULT_EXCHANGE=TSE
SHIOAJI_FETCH_CONTRACT=true
SHIOAJI_CONTRACTS_TIMEOUT=30000
SHIOAJI_RECEIVE_WINDOW=30000

# CA is required for real trading orders. Keep the file outside git-tracked paths.
SHIOAJI_CA_PATH=
SHIOAJI_CA_PASSWORD=
SHIOAJI_PERSON_ID=

# Hard safety switch. Keep false until simulation and risk checks are validated.
ALLOW_LIVE_TRADING=false

# AI Advisor (local Ollama only for now; no OpenAI/Gemini keys)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
